  "components": {
    "schemas": {
      "ProductoRequestDTO": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "maxLength": 150,
            "minLength": 3
          },
          "precio": {
            "type": "number",
            "minimum": 0.01
          },
          "stock": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "estado": {
            "type": "boolean"
          },
          "categoriaId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "categoriaId",
          "estado",
          "nombre",
          "precio",
          "stock"
        ]
      },
      "ProductoResponseDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "nombre": {
            "type": "string"
          },
          "precio": {
            "type": "number"
          },
          "stock": {
            "type": "integer",
            "format": "int32"
          },
          "estado": {
            "type": "boolean"
          },
          "categoriaId": {
            "type": "integer",
            "format": "int64"
          },
          "categoriaNombre": {
            "type": "string"
          },
          "fechaCreacion": {
            "type": "string",
            "format": "date-time"
          },
          "fechaModificacion": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ClienteRequestDTO": {
        "type": "object",
        "properties": {
          "dni": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\d{8}"
          },
          "nombres": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2
          },
          "apellidos": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 150,
            "minLength": 0
          },
          "telefono": {
            "type": "string",
            "pattern": "^\\d{9}$"
          },
          "direccion": {
            "type": "string",
            "maxLength": 250,
            "minLength": 0
          },
          "estado": {
            "type": "boolean"
          }
        },
        "required": [
          "apellidos",
          "dni",
          "email",
          "estado",
          "nombres"
        ]
      },
      "ClienteResponseDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "dni": {
            "type": "string"
          },
          "nombres": {
            "type": "string"
          },
          "apellidos": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "telefono": {
